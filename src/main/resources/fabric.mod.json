{
  "schemaVersion": 1,
  "id": "caszual_mtg",
  "version": "${version}",
  "name": "Caszual MTG",
  "description": "Shared card collections, unlimited lands and tokens, decklist assembly, large previews and readable counters for MTGCard.",
  "authors": [
    "Casz"
  ],
  "license": "MIT",
  "icon": "assets/caszual_mtg/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.casz.caszualmtg.CaszualMtg"
    ],
    "client": [
      "dev.casz.caszualmtg.CaszualMtgClient"
    ]
  },
  "mixins": [
    {
      "config": "caszual_mtg.client.mixins.json",
      "environment": "client"
    },
    "caszual_mtg.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.161.0+26.2",
    "minecraft": "26.2",
    "java": ">=25",
    "mtgcard": "1.7.0-26.2"
  }
}
