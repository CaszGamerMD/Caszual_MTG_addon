    { "when": { "facing": "south", "lit": "true", "color": "copper" }, "apply": { "model": "mtgcard:block/deck_control_copper", "x": 90, "y": 180 } },
    { "when": { "facing": "west", "lit": "true", "color": "copper" }, "apply": { "model": "mtgcard:block/deck_control_copper", "x": 90, "y": 270 } },
    { "when": { "facing": "east", "lit": "true", "color": "copper" }, "apply": { "model": "mtgcard:block/deck_control_copper", "x": 90, "y": 90 } }
