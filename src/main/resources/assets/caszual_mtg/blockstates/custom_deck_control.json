    { "when": { "facing": "up", "lit": "true", "color": "soulfire" }, "apply": { "model": "mtgcard:block/deck_control_soulfire" } },
    { "when": { "facing": "down", "lit": "true", "color": "soulfire" }, "apply": { "model": "mtgcard:block/deck_control_soulfire", "x": 180 } },
    { "when": { "facing": "north", "lit": "true", "color": "soulfire" }, "apply": { "model": "mtgcard:block/deck_control_soulfire", "x": 90 } },
