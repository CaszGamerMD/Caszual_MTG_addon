    { "when": { "facing": "east", "lit": "false" }, "apply": { "model": "mtgcard:block/deck_control_unlit", "x": 90, "y": 90 } },

    { "when": { "facing": "up", "lit": "true", "color": "default" }, "apply": { "model": "mtgcard:block/deck_control_lit" } },
    { "when": { "facing": "down", "lit": "true", "color": "default" }, "apply": { "model": "mtgcard:block/deck_control_lit", "x": 180 } },
