{
  "multipart": [
    { "when": { "facing": "up" }, "apply": { "model": "caszual_mtg:block/custom_deck_control" } },
    { "when": { "facing": "down" }, "apply": { "model": "caszual_mtg:block/custom_deck_control", "x": 180 } },
    { "when": { "facing": "north" }, "apply": { "model": "caszual_mtg:block/custom_deck_control", "x": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "caszual_mtg:block/custom_deck_control", "x": 90, "y": 180} },
    { "when": { "facing": "west" }, "apply": { "model": "caszual_mtg:block/custom_deck_control", "x": 90, "y": 270 } },
    { "when": { "facing": "east" }, "apply": { "model": "caszual_mtg:block/custom_deck_control", "x": 90, "y": 90} },

    { "when": { "facing": "up", "lit": "false" }, "apply": { "model": "mtgcard:block/deck_control_unlit" } },
