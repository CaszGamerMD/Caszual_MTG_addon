    { "when": { "facing": "east", "lit": "true", "color": "soulfire" }, "apply": { "model": "mtgcard:block/deck_control_soulfire", "x": 90, "y": 90 } },

    { "when": { "facing": "up", "lit": "true", "color": "redstone" }, "apply": { "model": "mtgcard:block/deck_control_redstone" } },
    { "when": { "facing": "down", "lit": "true", "color": "redstone" }, "apply": { "model": "mtgcard:block/deck_control_redstone", "x": 180 } },
    { "when": { "facing": "north", "lit": "true", "color": "redstone" }, "apply": { "model": "mtgcard:block/deck_control_redstone", "x": 90 } },
